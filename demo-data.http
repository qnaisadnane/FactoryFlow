### ==============================================================================
### FACTORYFLOW - SCÉNARIO COMPLET DE DÉMONSTRATION (REST CLIENT)
### ==============================================================================
@baseUrl = http://localhost:3000/api

### ------------------------------------------------------------------------------
### 1. VÉRIFICATION DU STATUT D'INSTALLATION
### ------------------------------------------------------------------------------
# @name getInstallationStatus
GET {{baseUrl}}/installation/status
Accept: application/json

### ------------------------------------------------------------------------------
### 2. PREMIÈRE INSTALLATION (Création du premier compte Administrateur)
### ------------------------------------------------------------------------------
# @name installerAdmin
POST {{baseUrl}}/installation
Content-Type: application/json

{
  "nom": "Adnane Administrateur",
  "email": "admin@factoryflow.com",
  "password": "Password123!"
}

### ------------------------------------------------------------------------------
### 3. CONNEXION DE L'ADMINISTRATEUR (Récupération du token JWT)
### ------------------------------------------------------------------------------
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@factoryflow.com",
  "password": "Password123!"
}

### Stocker le token admin pour les requêtes suivantes
@adminToken = {{loginAdmin.response.body.data.token}}

### ------------------------------------------------------------------------------
### 4. CRÉATION D'UN COMPTE OPÉRATEUR (Par l'Admin)
### ------------------------------------------------------------------------------
# @name creerOperateur
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "nom": "Karim Opérateur",
  "email": "karim@factoryflow.com",
  "password": "OperatorPassword123!",
  "role": "operateur"
}

### Stocker l'identifiant de l'opérateur créé
@operateurId = {{creerOperateur.response.body.data.id}}

### ------------------------------------------------------------------------------
### 5. CONNEXION DE L'OPÉRATEUR
### ------------------------------------------------------------------------------
# @name loginOperateur
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "karim@factoryflow.com",
  "password": "OperatorPassword123!"
}

@operateurToken = {{loginOperateur.response.body.data.token}}

### ------------------------------------------------------------------------------
### 6. CRÉATION DES MATIÈRES PREMIÈRES (Admin)
### ------------------------------------------------------------------------------
# @name creerAcier
POST {{baseUrl}}/matieres
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reference": "MAT-ACIER-01",
  "nom": "Tôle d'acier inoxydable",
  "uniteMesure": "kg",
  "seuilAlerte": 50
}

@acierId = {{creerAcier.response.body.data._id}}

###
# @name creerVis
POST {{baseUrl}}/matieres
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reference": "MAT-VIS-02",
  "nom": "Vis inox M6",
  "uniteMesure": "pièce",
  "seuilAlerte": 200
}

@visId = {{creerVis.response.body.data._id}}

### ------------------------------------------------------------------------------
### 7. ENTRÉES DE STOCK (Admin)
### ------------------------------------------------------------------------------
# Approvisionnement de l'Acier (+100 kg)
POST {{baseUrl}}/matieres/{{acierId}}/entrees
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "quantite": 100
}

###
# Approvisionnement des Vis (+500 pièces)
POST {{baseUrl}}/matieres/{{visId}}/entrees
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "quantite": 500
}

### ------------------------------------------------------------------------------
### 8. VÉRIFICATION DU STOCK & ALERTES
### ------------------------------------------------------------------------------
# Lister toutes les matières premières
GET {{baseUrl}}/matieres
Authorization: Bearer {{adminToken}}

###
# Consulter l'historique des mouvements de stock de l'acier
GET {{baseUrl}}/matieres/{{acierId}}/mouvements?page=1&limit=10
Authorization: Bearer {{adminToken}}

###
# Consulter les matières sous le seuil d'alerte (devrait être vide si stock > seuil)
GET {{baseUrl}}/matieres/alertes
Authorization: Bearer {{adminToken}}

### ------------------------------------------------------------------------------
### 9. CRÉATION D'UN PRODUIT FINI AVEC NOMENCLATURE / COMPOSITION (Admin)
### ------------------------------------------------------------------------------
# Pour fabriquer 1 "Boîtier Métallique", il faut 2 kg d'acier et 4 vis
# @name creerProduit
POST {{baseUrl}}/produits
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reference": "PROD-BOITIER-X1",
  "nom": "Boîtier métallique industriel X1",
  "composition": [
    {
      "matiere": "{{acierId}}",
      "quantiteUnitaire": 2
    },
    {
      "matiere": "{{visId}}",
      "quantiteUnitaire": 4
    }
  ]
}

@produitId = {{creerProduit.response.body.data._id}}

### ------------------------------------------------------------------------------
### 10. PLANIFICATION D'UN ORDRE DE FABRICATION (Admin)
### ------------------------------------------------------------------------------
# Fabriquer 10 boîtiers assignés à l'opérateur Karim
# Besoins calculés : 20 kg d'acier et 40 vis
# @name creerOrdre
POST {{baseUrl}}/ordres
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "produitId": "{{produitId}}",
  "quantite": 10,
  "operateurId": "{{operateurId}}"
}

@ordreId = {{creerOrdre.response.body.data._id}}

### ------------------------------------------------------------------------------
### 11. VUE OPÉRATEUR : CONSULTATION DE SES ORDRES
### ------------------------------------------------------------------------------
GET {{baseUrl}}/ordres/mes-ordres?statut=planifié
Authorization: Bearer {{operateurToken}}

### ------------------------------------------------------------------------------
### 12. DÉMARRAGE DE L'ORDRE PAR L'OPÉRATEUR (Vérification et déduction atomique)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/ordres/{{ordreId}}/demarrer
Authorization: Bearer {{operateurToken}}

### ------------------------------------------------------------------------------
### 13. VÉRIFICATION DE LA DÉDUCTION DU STOCK
### ------------------------------------------------------------------------------
# Le stock d'acier doit être passé de 100 à 80 kg
# Le stock de vis doit être passé de 500 à 460 pièces
GET {{baseUrl}}/matieres/{{acierId}}
Authorization: Bearer {{adminToken}}

### ------------------------------------------------------------------------------
### 14. TERMINAISON DE L'ORDRE PAR L'OPÉRATEUR
### ------------------------------------------------------------------------------
POST {{baseUrl}}/ordres/{{ordreId}}/terminer
Authorization: Bearer {{operateurToken}}

### ------------------------------------------------------------------------------
### 15. CONSULTATION FINALE DU DÉTAIL DE L'ORDRE
### ------------------------------------------------------------------------------
GET {{baseUrl}}/ordres/{{ordreId}}
Authorization: Bearer {{operateurToken}}
